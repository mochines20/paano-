# ------------------------------------------------------------------
# PAANO environment — kopyahin ito papunta sa .env.local at punan.
# NEVER i-commit ang .env.local (nasa .gitignore na ito).
# ------------------------------------------------------------------

# LLM provider: "gemini" (default) | "groq"
# Kung hindi set: Gemini kung may GEMINI_API_KEY, kung wala ay Groq.
LLM_PROVIDER=gemini

# --- Gemini (Google AI Studio: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Optional: default ay "gemini-2.5-flash"
GEMINI_MODEL=gemini-2.5-flash

# --- Groq (https://console.groq.com/keys) ---
# OpenAI-compatible API; mura/fast. Tested models:
#   openai/gpt-oss-20b (default, magandang Taglish), groq/compound,
#   llama-3.3-70b-versatile
GROQ_API_KEY=
# Optional: default ay "openai/gpt-oss-20b"
GROQ_MODEL=openai/gpt-oss-20b

# Supabase (https://supabase.com) — optional sa dev; kailangan para sa
# per-IP question logging. I-run ang supabase/schema.sql sa SQL editor.
SUPABASE_URL=
SUPABASE_ANON_KEY=
