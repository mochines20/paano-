# ------------------------------------------------------------------
# PAANO environment — kopyahin ito papunta sa .env.local at punan.
# NEVER i-commit ang .env.local (nasa .gitignore na ito).
# ------------------------------------------------------------------

# LLM provider: "gemini" (default) | "groq"
# Kung hindi set: Gemini kung may GEMINI_API_KEY, kung wala ay Groq.
LLM_PROVIDER=groq

# --- Gemini (Google AI Studio: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Optional: default ay "gemini-2.5-flash"
GEMINI_MODEL=gemini-2.5-flash

# --- Groq (https://console.groq.com/keys) ---
# OpenAI-compatible API; mura/fast. Tested models:
#   openai/gpt-oss-20b (default, magandang Taglish), groq/compound,
#   llama-3.3-70b-versatile
GROQ_API_KEY=
# Optional: default ay "openai/gpt-oss-20b"
GROQ_MODEL=openai/gpt-oss-20b
# Vision model para sa image→recipe (may image input support):
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# --- Rate limits (cost control) ---
# Free tier: 15 tanong/araw bawat IP, max 5 requests/min.
# PAANO_DAILY_LIMIT=15
# PAANO_BURST_LIMIT=5

# --- DA Bantay Presyo (optional) ---
# Kung may na-crawl na JSON prices [{item, pricePerKg}], ilagay ang URL;
# kung wala, gagamit ang PAANO ng fallback table (naka-label na tantiya).
# DA_PRICE_URL=

# Supabase (https://supabase.com) — kailangan para sa:
#   - per-IP question logging (question_logs)
#   - community feedback (answer_feedback)
#   - trending questions (top "paano" sa 30 araw)
# I-run ang supabase/schema.sql sa SQL editor.
SUPABASE_URL=
SUPABASE_ANON_KEY=
