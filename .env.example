# ------------------------------------------------------------------
# PAANO environment — kopyahin ito papunta sa .env.local at punan.
# NEVER i-commit ang .env.local (nasa .gitignore na ito).
# ------------------------------------------------------------------

# LLM provider: "auto" (recommended chain) | "ollama" | "gemini" | "groq"
# auto: curated answers → Groq text → Gemini complex/vision → Ollama fallback.
LLM_PROVIDER=auto

# --- Ollama sa VPS ---
# Halimbawa: http://5.223.78.194:11434 (server-side only; huwag ilagay sa client code)
OLLAMA_BASE_URL=
# Recommended local model: Qwen3.5 4B (text + vision)
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_VISION_MODEL=qwen3.5:4b

# --- Gemini (Google AI Studio: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Optional: Gemini model for difficult text + vision fallback.
# Use a model enabled for your API project; gemini-2.5-flash is broadly available.
GEMINI_MODEL=gemini-2.5-flash

# --- Groq (https://console.groq.com/keys) ---
# OpenAI-compatible API; mura/fast. Tested models:
#   openai/gpt-oss-20b (default, magandang Taglish), groq/compound,
#   llama-3.3-70b-versatile
GROQ_API_KEY=
# Optional: default ay "openai/gpt-oss-20b"
GROQ_MODEL=openai/gpt-oss-20b
# Optional only. Leave blank unless you explicitly configure a currently
# supported Groq vision model. Normal text uses GPT-OSS 20B; Gemini handles
# vision first and Ollama/Qwen is the local fallback.
GROQ_VISION_MODEL=

# --- Rate limits (cost control) ---
# Free tier: 15 tanong/araw bawat IP, max 5 requests/min.
# PAANO_DAILY_LIMIT=15
# PAANO_BURST_LIMIT=5

# --- DA Bantay Presyo (optional) ---
# Kung may na-crawl na JSON prices [{item, pricePerKg}], ilagay ang URL;
# kung wala, gagamit ang PAANO ng fallback table (naka-label na tantiya).
# DA_PRICE_URL=

# Supabase (https://supabase.com) — kailangan para sa:
#   - per-IP question logging (question_logs)
#   - community feedback (answer_feedback)
#   - trending questions (top "paano" sa 30 araw)
# I-run ang supabase/schema.sql sa SQL editor.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Daily source refresh (server/cron only; never expose service role key to browser)
SUPABASE_SERVICE_ROLE_KEY=
KNOWLEDGE_REVIEW_TOKEN=
# JSON feeds only; missing feeds remain needs_review and never become live data.
DA_PRICE_URL=
LTFRB_FEED_URL=
# Optional commute JSON feeds. The updater only creates pending candidates;
# a human must review/approve them before any promotion to live curated data.
PITX_ROUTES_URL=
ONE_AYALA_ROUTES_URL=
LGU_TRANSPORT_FEED_URL=
SAKAYPH_GTFS_JSON_URL=
TRANSITLAND_ROUTES_URL=
BUSMAPS_ROUTES_URL=
